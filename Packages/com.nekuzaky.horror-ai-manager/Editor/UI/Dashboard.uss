:root {
    --ha-bg: rgb(22, 21, 24);
    --ha-panel: rgb(29, 28, 32);
    --ha-raised: rgb(39, 37, 42);
    --ha-raised-hover: rgb(49, 47, 53);
    --ha-border: rgb(50, 47, 54);
    --ha-text: rgb(224, 222, 228);
    --ha-text-2: rgb(154, 150, 160);
    --ha-text-3: rgb(108, 104, 114);
    --ha-icon: rgb(200, 197, 205);
    --ha-accent: rgb(226, 82, 92);
    --ha-accent-soft: rgba(226, 82, 92, 0.16);
    --ha-good: rgb(96, 190, 132);
    --ha-warn: rgb(222, 170, 72);
    --ha-bad: rgb(226, 96, 96);
    --ha-info: rgb(92, 166, 214);
    --ha-graph: rgb(17, 16, 19);
    --ha-patrol: rgb(89, 217, 128);
    --ha-alert: rgb(255, 217, 51);
    --ha-investigate: rgb(255, 153, 38);
    --ha-search: rgb(191, 115, 255);
    --ha-chase: rgb(255, 72, 72);
    --ha-lost: rgb(242, 89, 153);
    --ha-idle: rgb(150, 146, 156);
}

.ha-light {
    --ha-bg: rgb(222, 222, 224);
    --ha-panel: rgb(236, 236, 238);
    --ha-raised: rgb(212, 212, 216);
    --ha-raised-hover: rgb(200, 200, 205);
    --ha-border: rgb(184, 184, 190);
    --ha-text: rgb(28, 27, 31);
    --ha-text-2: rgb(78, 76, 84);
    --ha-text-3: rgb(118, 116, 124);
    --ha-icon: rgb(60, 58, 66);
    --ha-accent: rgb(186, 40, 54);
    --ha-accent-soft: rgba(186, 40, 54, 0.14);
    --ha-good: rgb(36, 132, 76);
    --ha-warn: rgb(168, 112, 10);
    --ha-bad: rgb(190, 44, 44);
    --ha-info: rgb(40, 112, 170);
    --ha-graph: rgb(246, 246, 248);
    --ha-patrol: rgb(30, 150, 70);
    --ha-alert: rgb(170, 132, 0);
    --ha-investigate: rgb(204, 104, 0);
    --ha-search: rgb(130, 60, 210);
    --ha-chase: rgb(206, 30, 30);
    --ha-lost: rgb(194, 40, 110);
    --ha-idle: rgb(110, 108, 116);
}

.ha-root {
    flex-grow: 1;
    background-color: var(--ha-bg);
    color: var(--ha-text);
    font-size: 12px;
}

.ha-root Label { color: var(--ha-text); }

.ha-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ha-icon);
}

.ha-icon--small { width: 12px; height: 12px; }
.ha-icon--large { width: 18px; height: 18px; }
.ha-icon--dim { -unity-background-image-tint-color: var(--ha-text-2); }
.ha-icon--accent { -unity-background-image-tint-color: var(--ha-accent); }
.ha-icon--good { -unity-background-image-tint-color: var(--ha-good); }
.ha-icon--warn { -unity-background-image-tint-color: var(--ha-warn); }
.ha-icon--bad { -unity-background-image-tint-color: var(--ha-bad); }
.ha-icon--info { -unity-background-image-tint-color: var(--ha-info); }

.ha-tile { width: 16px; height: 16px; flex-shrink: 0; margin-right: 6px; }
.ha-tile--logo { width: 20px; height: 20px; margin-right: 8px; }
.ha-tile--large { width: 28px; height: 28px; margin-right: 10px; }

.ha-spacer { flex-grow: 1; }

.ha-header {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    flex-shrink: 0;
    flex-wrap: wrap;
    padding: 4px 8px 4px 10px;
    background-color: var(--ha-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--ha-border);
}

.ha-title { -unity-font-style: bold; font-size: 13px; margin-right: 12px; }

.ha-tab {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    margin: 0 1px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ha-tab:hover { background-color: var(--ha-raised); }
.ha-tab .ha-icon { margin-right: 6px; }
.ha-tab Label { color: var(--ha-text-2); }
.ha-tab--active { background-color: var(--ha-accent-soft); }
.ha-tab--active Label { color: var(--ha-text); }
.ha-tab--active .ha-icon { -unity-background-image-tint-color: var(--ha-accent); }

.ha-pill {
    padding: 2px 8px;
    border-radius: 9px;
    background-color: var(--ha-raised);
    color: var(--ha-text-2);
    font-size: 11px;
    margin: 0 4px;
}

.ha-root .ha-pill--live { background-color: rgba(96, 190, 132, 0.18); color: var(--ha-good); }
.ha-root .ha-pill--paused { background-color: rgba(222, 170, 72, 0.2); color: var(--ha-warn); }

.ha-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 24px;
    min-width: 24px;
    padding: 0 8px;
    margin: 0 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ha-border);
    background-color: var(--ha-raised);
}

.ha-button:hover { background-color: var(--ha-raised-hover); }
.ha-button Label { color: var(--ha-text); }
.ha-button-label { margin-left: 6px; }
.ha-button--icon { padding: 0; width: 24px; }
.ha-button--flat { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.ha-button--on { background-color: var(--ha-accent-soft); border-color: var(--ha-accent); }
.ha-button--on .ha-icon { -unity-background-image-tint-color: var(--ha-accent); }
.ha-button--primary { background-color: var(--ha-accent-soft); border-color: var(--ha-accent); }

.ha-body { flex-grow: 1; }
.ha-view { flex-grow: 1; }
.ha-scroll { flex-grow: 1; }
.ha-page { padding: 12px; }

.ha-help { color: var(--ha-text-3); white-space: normal; font-size: 11px; margin: 2px 0 8px 0; }
.ha-root .ha-help { color: var(--ha-text-3); }

.ha-section {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 6px 0;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ha-border);
}

.ha-section Label { color: var(--ha-text-2); -unity-font-style: bold; font-size: 11px; }
.ha-root .ha-section Label { color: var(--ha-text-2); }
.ha-section .ha-icon { margin-right: 6px; }

.ha-cards { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }

.ha-card {
    min-width: 150px;
    flex-grow: 1;
    flex-basis: 150px;
    flex-shrink: 0;
    padding: 8px 12px 10px 12px;
    margin: 0 8px 8px 0;
    border-radius: 6px;
    background-color: var(--ha-panel);
    border-width: 1px;
    border-color: var(--ha-border);
}

.ha-card--state { min-width: 104px; flex-basis: 104px; border-left-width: 3px; }
.ha-card-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.ha-card-head .ha-icon { margin-right: 6px; }
.ha-card-label { color: var(--ha-text-2); font-size: 11px; }
.ha-root .ha-card-label { color: var(--ha-text-2); }
.ha-card-value { font-size: 18px; -unity-font-style: bold; }
.ha-card-detail { color: var(--ha-text-3); font-size: 11px; white-space: normal; }
.ha-root .ha-card-detail { color: var(--ha-text-3); }

.ha-graphs { flex-direction: row; flex-wrap: wrap; }

.ha-graph-box {
    flex-grow: 1;
    flex-basis: 260px;
    min-width: 220px;
    margin: 0 8px 8px 0;
    padding: 8px 10px;
    border-radius: 6px;
    background-color: var(--ha-panel);
    border-width: 1px;
    border-color: var(--ha-border);
}

.ha-graph-title { flex-direction: row; align-items: center; margin-bottom: 6px; }
.ha-graph-title .ha-icon { margin-right: 6px; }
.ha-graph-value { color: var(--ha-text-2); font-size: 11px; }
.ha-root .ha-graph-value { color: var(--ha-text-2); }

.ha-spark {
    height: 64px;
    border-radius: 4px;
    background-color: var(--ha-graph);
    color: var(--ha-accent);
}

.ha-spark--suspicion { color: var(--ha-investigate); }
.ha-spark--tall { height: 90px; }

.ha-split { flex-grow: 1; flex-direction: row; }

.ha-list-pane {
    flex-grow: 1;
    flex-basis: 55%;
    min-width: 280px;
    border-right-width: 1px;
    border-right-color: var(--ha-border);
}

.ha-detail-pane { flex-grow: 1; flex-basis: 45%; min-width: 240px; }

.ha-table-header {
    flex-direction: row;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    padding: 0 8px;
    background-color: var(--ha-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--ha-border);
}

.ha-table-header Label { color: var(--ha-text-3); font-size: 11px; }
.ha-root .ha-table-header Label { color: var(--ha-text-3); }

.ha-row { flex-direction: row; align-items: center; height: 28px; padding: 0 8px; }
.ha-row Label { overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; white-space: nowrap; }
.ha-root .unity-collection-view__item--selected { background-color: var(--ha-accent-soft); }
.ha-root .unity-list-view__item:hover { background-color: var(--ha-raised); }

.ha-col-name { width: 150px; flex-grow: 1; -unity-font-style: bold; }
.ha-col-state { width: 92px; }
.ha-col-bar { width: 96px; flex-direction: row; align-items: center; }
.ha-col-target { width: 90px; color: var(--ha-text-2); }
.ha-col-distance { width: 56px; -unity-text-align: middle-right; padding-right: 8px; }
.ha-col-reason { width: 170px; flex-grow: 1; color: var(--ha-text-2); }
.ha-col-time { width: 84px; color: var(--ha-text-2); }
.ha-col-source { width: 130px; flex-grow: 1; }
.ha-col-loud { width: 56px; -unity-text-align: middle-right; padding-right: 8px; }
.ha-col-position { width: 120px; color: var(--ha-text-2); }
.ha-col-heard { width: 200px; flex-grow: 2; color: var(--ha-text-2); }
.ha-root .ha-col-target, .ha-root .ha-col-reason, .ha-root .ha-col-time, .ha-root .ha-col-position, .ha-root .ha-col-heard { color: var(--ha-text-2); }

.ha-chip {
    padding: 1px 7px;
    border-radius: 9px;
    border-width: 1px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-color: var(--ha-idle);
    color: var(--ha-idle);
    background-color: rgba(128, 128, 128, 0.10);
}

.ha-root .ha-chip { color: var(--ha-idle); }
.ha-root .ha-state--patrol { color: var(--ha-patrol); border-color: var(--ha-patrol); background-color: rgba(89, 217, 128, 0.12); }
.ha-root .ha-state--alert { color: var(--ha-alert); border-color: var(--ha-alert); background-color: rgba(255, 217, 51, 0.12); }
.ha-root .ha-state--investigate { color: var(--ha-investigate); border-color: var(--ha-investigate); background-color: rgba(255, 153, 38, 0.12); }
.ha-root .ha-state--search { color: var(--ha-search); border-color: var(--ha-search); background-color: rgba(191, 115, 255, 0.12); }
.ha-root .ha-state--chase { color: var(--ha-chase); border-color: var(--ha-chase); background-color: rgba(255, 72, 72, 0.14); }
.ha-root .ha-state--losttrack { color: var(--ha-lost); border-color: var(--ha-lost); background-color: rgba(242, 89, 153, 0.12); }

.ha-card.ha-state--patrol { border-left-color: var(--ha-patrol); background-color: var(--ha-panel); }
.ha-card.ha-state--alert { border-left-color: var(--ha-alert); background-color: var(--ha-panel); }
.ha-card.ha-state--investigate { border-left-color: var(--ha-investigate); background-color: var(--ha-panel); }
.ha-card.ha-state--search { border-left-color: var(--ha-search); background-color: var(--ha-panel); }
.ha-card.ha-state--chase { border-left-color: var(--ha-chase); background-color: var(--ha-panel); }
.ha-card.ha-state--losttrack { border-left-color: var(--ha-lost); background-color: var(--ha-panel); }
.ha-card.ha-state--patrol .ha-icon { -unity-background-image-tint-color: var(--ha-patrol); }
.ha-card.ha-state--alert .ha-icon { -unity-background-image-tint-color: var(--ha-alert); }
.ha-card.ha-state--investigate .ha-icon { -unity-background-image-tint-color: var(--ha-investigate); }
.ha-card.ha-state--search .ha-icon { -unity-background-image-tint-color: var(--ha-search); }
.ha-card.ha-state--chase .ha-icon { -unity-background-image-tint-color: var(--ha-chase); }
.ha-card.ha-state--losttrack .ha-icon { -unity-background-image-tint-color: var(--ha-lost); }

.ha-bar { flex-grow: 1; height: 6px; border-radius: 3px; background-color: var(--ha-raised); margin-right: 6px; }
.ha-bar-fill { height: 6px; border-radius: 3px; background-color: var(--ha-investigate); width: 0px; }
.ha-bar-fill--high { background-color: var(--ha-chase); }
.ha-bar-text { width: 34px; font-size: 11px; -unity-text-align: middle-right; }

.ha-detail { padding: 10px 12px 16px 12px; }
.ha-detail-head { flex-direction: row; align-items: center; margin-bottom: 4px; flex-wrap: wrap; }
.ha-detail-name { font-size: 15px; -unity-font-style: bold; margin-right: 8px; }

.ha-kv { flex-direction: row; align-items: flex-start; min-height: 20px; }
.ha-kv-key { width: 150px; flex-shrink: 0; color: var(--ha-text-2); }
.ha-root .ha-kv-key { color: var(--ha-text-2); }
.ha-kv-value { flex-grow: 1; flex-shrink: 1; white-space: normal; }

.ha-timeline-row { flex-direction: row; align-items: center; min-height: 22px; }
.ha-timeline-time { width: 60px; color: var(--ha-text-3); font-size: 11px; }
.ha-root .ha-timeline-time { color: var(--ha-text-3); }
.ha-timeline-arrow { color: var(--ha-text-3); margin: 0 4px; }
.ha-root .ha-timeline-arrow { color: var(--ha-text-3); }
.ha-timeline-reason { flex-grow: 1; flex-shrink: 1; margin-left: 8px; color: var(--ha-text-2); white-space: normal; }
.ha-root .ha-timeline-reason { color: var(--ha-text-2); }

.ha-empty { flex-grow: 1; align-items: center; justify-content: center; padding: 24px; }
.ha-empty-title { font-size: 15px; -unity-font-style: bold; margin-bottom: 6px; -unity-text-align: middle-center; }
.ha-empty-text { color: var(--ha-text-2); white-space: normal; -unity-text-align: middle-center; max-width: 440px; }
.ha-root .ha-empty-text { color: var(--ha-text-2); }

.ha-check {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px 10px;
    margin-bottom: 6px;
    border-radius: 6px;
    background-color: var(--ha-panel);
    border-width: 1px;
    border-color: var(--ha-border);
    border-left-width: 3px;
}

.ha-check--ok { border-left-color: var(--ha-good); }
.ha-check--info { border-left-color: var(--ha-info); }
.ha-check--warn { border-left-color: var(--ha-warn); }
.ha-check--error { border-left-color: var(--ha-bad); }
.ha-check > .ha-icon { margin: 2px 10px 0 0; }
.ha-check-text { flex-grow: 1; flex-shrink: 1; }
.ha-check-title { -unity-font-style: bold; white-space: normal; }
.ha-check-detail { color: var(--ha-text-2); white-space: normal; font-size: 11px; margin-top: 2px; }
.ha-root .ha-check-detail { color: var(--ha-text-2); }
.ha-check .ha-button { margin-left: 8px; }

.ha-toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
.ha-toolbar .ha-button { margin: 0 6px 6px 0; }

.ha-asset {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px 10px;
    margin-bottom: 6px;
    border-radius: 6px;
    background-color: var(--ha-panel);
    border-width: 1px;
    border-color: var(--ha-border);
}

.ha-asset:hover { border-color: var(--ha-text-3); }
.ha-asset-text { flex-grow: 1; flex-shrink: 1; }
.ha-asset-name { -unity-font-style: bold; }
.ha-asset-path { color: var(--ha-text-3); font-size: 10px; margin-bottom: 4px; }
.ha-root .ha-asset-path { color: var(--ha-text-3); }
.ha-asset-summary { white-space: normal; color: var(--ha-text-2); font-size: 11px; }
.ha-root .ha-asset-summary { color: var(--ha-text-2); }
.ha-card-head > .ha-card-detail { margin-right: 4px; }

.ha-root .unity-list-view__empty-label { display: none; }
.ha-list-empty { padding: 16px 10px; white-space: normal; font-size: 12px; }
.ha-root .ha-list-empty { color: var(--ha-text-2); }

.ha-card-foot { flex-wrap: wrap; }
.ha-card-extra { flex-shrink: 0; }

.ha-col-state { flex-shrink: 0; align-items: flex-start; justify-content: center; }
.ha-row .ha-chip { overflow: visible; text-overflow: clip; flex-shrink: 0; }

.ha-split--narrow { flex-direction: column; }
.ha-split--narrow > .ha-list-pane {
    flex-basis: 50%;
    min-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--ha-border);
}
.ha-split--narrow > .ha-detail-pane { flex-basis: 50%; min-width: 0; }
.ha-split--narrow .ha-col-reason, .ha-split--narrow .ha-col-distance { display: none; }
.ha-split--narrow .ha-col-name { width: 90px; }
